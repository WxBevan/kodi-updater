<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.updater"
       name="Updater"
       version="1.0.9"
       provider-name="updater">

    <requires>
        <!-- Core Kodi APIs -->
        <import addon="xbmc.gui" version="5.17.0"/>
        <import addon="xbmc.python" version="3.0.0"/>

        <!-- Bingie requirements. Kodi resolves these as one dependency job
             when Updater itself is installed or updated. -->
        <import addon="script.bingie.helper" version="1.1.2"/>
        <import addon="script.bingie.toolbox" version="1.0.0"/>
        <import addon="script.bingie.widgets" version="1.0.1"/>
        <import addon="script.skinshortcuts" version="2.0.3"/>
        <import addon="resource.images.studios.coloured" version="1.0.0"/>
        <import addon="plugin.video.tmdb.bingie.helper" version="1.0.1"/>
        <import addon="plugin.program.autocompletion" version="2.1.3"/>
        <import addon="resource.images.studios.white" version="0.0.0"/>

        <!-- FLAM build requirements -->
        <import addon="script.module.cocoscrapers" version="0.0.0"/>
        <import addon="script.module.jurialmunkey" version="0.0.0"/>
        <import addon="pvr.iptvsimple" version="0.0.0"/>
        <import addon="plugin.program.autowidget" version="0.0.0"/>
        <import addon="plugin.video.fenlight" version="0.0.0"/>
        <import addon="service.autostop" version="0.0.0"/>
        <import addon="skin.bingie" version="0.0.0"/>
    </requires>

    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.service" library="service.py"/>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Updater</summary>
        <description lang="en_GB">Installs, verifies and updates the Kodi setup.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <news>
            v1.0.8
            - Restores the complete dependency list for first installation.
            - Uses Kodi's normal repository updater instead of prompting once per add-on.
            - Waits for and verifies automatic add-on updates before saving the build.
            - Supports exact add-on versions in latest.json when supplied.
        </news>
    </extension>
</addon>
