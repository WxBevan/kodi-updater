<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <onload>Dialog.Close(videoosd,true)</onload>
    <animation effect="fade" end="100" time="600">WindowOpen</animation>
    <controls>
        <control type="image">
            <height>550</height>
            <texture>fenlight_common/dim-top.png</texture>
        </control>
        <control type="group">
            <left>40</left>
            <top>30</top>
            <height>250</height>
            <control type="image">
                <left>30</left><top>0</top><width>45</width><height>45</height>
                <aspectratio aligny="top">keep</aspectratio>
                <texture colordiffuse="FFB7B4BB">$INFO[Window(10000).Property(fenlight.addon_icon_mini)]</texture>
            </control>
            <control type="label">
                <left>85</left><height>45</height><aligny>center</aligny>
                <label>[B]Next Episode[/B]</label><font>font14</font><textcolor>FFB7B4BB</textcolor>
            </control>
            <control type="image">
                <left>30</left><top>58</top><width>190</width><height>107</height>
                <texture>$INFO[Window.Property(thumb)]</texture><aspectratio>scale</aspectratio>
            </control>
            <control type="label">
                <left>240</left><top>55</top><width>330</width><height>30</height>
                <label>[B]$INFO[Window.Property(episode_number)][/B]</label><font>font10</font><textcolor>FFB7B4BB</textcolor>
            </control>
            <control type="label">
                <left>240</left><top>86</top><width>330</width><height>34</height>
                <label>$INFO[Window.Property(episode_name)]</label><font>font10</font><textcolor>FFFFFFFF</textcolor>
            </control>
            <control type="label">
                <left>240</left><top>120</top><width>330</width><height>28</height>
                <label>$INFO[Window.Property(show_name)]</label><font>font10</font><textcolor>FFB7B4BB</textcolor>
            </control>
            <control type="label">
                <visible>!String.IsEmpty(Window.Property(episode_status.label))</visible>
                <left>240</left><top>146</top><width>330</width><height>25</height>
                <label>[B]$INFO[Window.Property(episode_status.label)][/B]</label><font>font10</font><textcolor>FFFFFFFF</textcolor>
            </control>
            <control type="grouplist">
                <left>30</left><top>185</top><width>530</width><height>60</height>
                <orientation>horizontal</orientation><itemgap>10</itemgap>
                <control type="button" id="11">
                    <description>Play</description><width>245</width><height>60</height><onleft>12</onleft><onright>12</onright>
                    <label>Play</label><font>font10</font><textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="FFCCCCCC" border="30">fenlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347" border="30">fenlight_common/circle.png</texturenofocus><align>center</align><aligny>center</aligny>
                </control>
                <control type="button" id="12">
                    <description>Cancel</description><width>245</width><height>60</height><onleft>11</onleft><onright>11</onright>
                    <label>Cancel</label><font>font10</font><textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="FFCCCCCC" border="30">fenlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="FF4a4347" border="30">fenlight_common/circle.png</texturenofocus><align>center</align><aligny>center</aligny>
                </control>
            </control>
        </control>
    </controls>
</window>
