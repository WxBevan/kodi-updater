<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">200</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="D9000000">fenlight_common/white.png</texture>
        </control>
        <control type="group">
            <left>120</left><top>60</top>
            <control type="image">
                <width>1680</width><height>960</height>
                <texture colordiffuse="FF1F2020" border="30">fenlight_common/circle.png</texture>
            </control>
            <control type="label">
                <left>45</left><top>28</top><width>1050</width><height>48</height>
                <font>font16</font><textcolor>FFFFFFFF</textcolor><label>[B]Manage Live TV Channels[/B]</label>
            </control>
            <control type="label" id="400">
                <left>1120</left><top>34</top><width>500</width><height>40</height>
                <font>font13</font><textcolor>FFCCCCCC</textcolor><align>right</align><label>0 channels enabled</label>
            </control>

            <control type="edit" id="100">
                <left>45</left><top>100</top><width>1370</width><height>62</height>
                <font>font13</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
                <hinttext>Search all channels…</hinttext>
                <texturefocus colordiffuse="FFEEEEEE" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF3B3D3D" border="20">fenlight_common/circle.png</texturenofocus>
                <onright>101</onright><ondown>200</ondown>
            </control>
            <control type="button" id="101">
                <left>1440</left><top>100</top><width>190</width><height>62</height>
                <label>Clear</label><font>font12</font><align>center</align><aligny>center</aligny>
                <textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                <texturefocus colordiffuse="FFCCCCCC" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF4A4C4C" border="20">fenlight_common/circle.png</texturenofocus>
                <onleft>100</onleft><ondown>200</ondown>
            </control>

            <control type="label" id="402">
                <left>45</left><top>177</top><width>1585</width><height>34</height>
                <font>font13</font><textcolor>FFFFFFFF</textcolor><label>Choose a Group</label>
            </control>

            <!-- Invisible focus parking control used only while the panel is
                 atomically rebuilt during group transitions. -->
            <control type="button" id="199">
                <left>-20</left><top>-20</top><width>1</width><height>1</height>
                <label></label><font>font10</font>
                <texturefocus></texturefocus><texturenofocus></texturenofocus>
                <onup>200</onup><ondown>200</ondown><onleft>200</onleft><onright>200</onright>
            </control>

            <!-- A single vertical panel with two columns. Both columns form one
                 selection/scroll container, so they always move together. -->
            <control type="panel" id="200">
                <left>45</left><top>215</top><width>1585</width><height>575</height>
                <orientation>Vertical</orientation>
                <onup>100</onup><ondown>302</ondown>
                <onleft condition="Container(200).Column(0)">302</onleft>
                <scrolltime tween="cubic" easing="out">180</scrolltime>
                <itemlayout height="82" width="792">
                    <control type="image">
                        <left>0</left><top>4</top><width>780</width><height>74</height>
                        <texture colordiffuse="FF292B2B" border="16">fenlight_common/circle.png</texture>
                    </control>
                    <control type="label">
                        <left>14</left><top>12</top><width>40</width><height>52</height>
                        <font>font16</font><textcolor>FFFFFFFF</textcolor><label>$INFO[ListItem.Property(check)]</label>
                    </control>
                    <control type="label">
                        <left>62</left><top>8</top><width>680</width><height>34</height>
                        <font>font13</font><textcolor>FFFFFFFF</textcolor><label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>62</left><top>42</top><width>680</width><height>25</height>
                        <font>font12</font><textcolor>FF9FA3A3</textcolor><label>$INFO[ListItem.Label2]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="82" width="792">
                    <control type="image">
                        <left>0</left><top>4</top><width>780</width><height>74</height>
                        <texture colordiffuse="FFCCCCCC" border="16">fenlight_common/circle.png</texture>
                    </control>
                    <control type="label">
                        <left>14</left><top>12</top><width>40</width><height>52</height>
                        <font>font16</font><textcolor>FF1F2020</textcolor><label>$INFO[ListItem.Property(check)]</label>
                    </control>
                    <control type="label">
                        <left>62</left><top>8</top><width>680</width><height>34</height>
                        <font>font13</font><textcolor>FF1F2020</textcolor><label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>62</left><top>42</top><width>680</width><height>25</height>
                        <font>font12</font><textcolor>FF555555</textcolor><label>$INFO[ListItem.Label2]</label>
                    </control>
                </focusedlayout>
            </control>

            <control type="label" id="401">
                <left>45</left><top>803</top><width>800</width><height>35</height>
                <font>font12</font><textcolor>FFAAAAAA</textcolor><label>0 groups</label>
            </control>

            <control type="button" id="304">
                <left>45</left><top>855</top><width>260</width><height>62</height>
                <label>Back to Groups</label><font>font12</font><align>center</align><aligny>center</aligny>
                <textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                <texturefocus colordiffuse="FFCCCCCC" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF4A4C4C" border="20">fenlight_common/circle.png</texturenofocus>
                <onup>200</onup><onright>300</onright>
            </control>
            <control type="button" id="300">
                <left>330</left><top>855</top><width>330</width><height>62</height>
                <label>Enable All Visible</label><font>font12</font><align>center</align><aligny>center</aligny>
                <textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                <texturefocus colordiffuse="FFCCCCCC" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF4A4C4C" border="20">fenlight_common/circle.png</texturenofocus>
                <onup>200</onup><onleft>304</onleft><onright>301</onright>
            </control>
            <control type="button" id="301">
                <left>685</left><top>855</top><width>340</width><height>62</height>
                <label>Disable All Visible</label><font>font12</font><align>center</align><aligny>center</aligny>
                <textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                <texturefocus colordiffuse="FFCCCCCC" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF4A4C4C" border="20">fenlight_common/circle.png</texturenofocus>
                <onup>200</onup><onleft>300</onleft><onright>302</onright>
            </control>
            <control type="button" id="302">
                <left>1050</left><top>855</top><width>300</width><height>62</height>
                <label>Save Changes</label><font>font12</font><align>center</align><aligny>center</aligny>
                <textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                <texturefocus colordiffuse="FFCCCCCC" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF4A4C4C" border="20">fenlight_common/circle.png</texturenofocus>
                <onup>200</onup><onleft>301</onleft><onright>303</onright>
            </control>
            <control type="button" id="303">
                <left>1375</left><top>855</top><width>255</width><height>62</height>
                <label>Cancel</label><font>font12</font><align>center</align><aligny>center</aligny>
                <textcolor>FFCCCCCC</textcolor><focusedcolor>FF1F2020</focusedcolor>
                <texturefocus colordiffuse="FFCCCCCC" border="20">fenlight_common/circle.png</texturefocus>
                <texturenofocus colordiffuse="FF4A4C4C" border="20">fenlight_common/circle.png</texturenofocus>
                <onup>200</onup><onleft>302</onleft>
            </control>
        </control>
    </controls>
</window>
