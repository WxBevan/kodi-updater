<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.updater"
       name="Updater Repository"
       version="1.0.1"
       provider-name="KodiPlus">

    <extension point="xbmc.addon.repository" name="Updater Repository">
        <dir>
            <info compressed="false">https://kodiplus.github.io/updater/addons.xml</info>
            <checksum>https://kodiplus.github.io/updater/addons.xml.md5</checksum>
            <datadir zip="true">https://kodiplus.github.io/updater/</datadir>
